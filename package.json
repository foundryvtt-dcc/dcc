{
  "author": "Tim L. White <tim@cyface.com>",
  "bugs": {
    "url": "https://github.com/foundryvtt-dcc/dcc/issues"
  },
  "description": "Dungeon Crawl Classics RPG Support for Foundry VTT",
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "classic-level": "^3.0.0",
    "husky": "^9.1.7",
    "sass": "^1.102.0",
    "standard": "^17.1.2",
    "stylelint": "^17.14.1",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "vitest": "^4.1.10"
  },
  "directories": {
    "test": "module/tests"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "homepage": "https://github.com/foundryvtt-dcc/dcc#readme",
  "keywords": [
    "FoundryVTT",
    "DCC",
    "Dungeon Crawl Classics"
  ],
  "license": "MIT",
  "main": "module/dcc.js",
  "name": "dcc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foundryvtt-dcc/dcc.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "check": "pnpm run format && pnpm run scss && pnpm run test && pnpm run compare-lang",
    "format": "standard --fix && stylelint \"**/*.scss\" --fix",
    "test": "vitest run module/",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test-watch": "vitest module/",
    "setup:foundry": "node scripts/setup-foundry-dev.js",
    "e2e:env": "node scripts/e2e-env.mjs",
    "work:start": "node scripts/work.mjs start",
    "work:list": "node scripts/work.mjs list",
    "work:sync": "node scripts/work.mjs sync",
    "work:finish": "node scripts/work.mjs finish",
    "scss": "sass styles/dcc.scss styles/dcc.css",
    "scss-watch": "sass --watch styles/dcc.scss styles/dcc.css",
    "todb": "node module/compilePacks.js",
    "tojson": "node module/extractPacks.js",
    "compare-lang": "node module/compare-lang-files.js lang/en.json lang/cn.json lang/de.json lang/es.json lang/fr.json lang/it.json lang/pl.json",
    "sync-core-lib": "node scripts/sync-core-lib.mjs",
    "prepare": "husky"
  },
  "standard": {
    "ignore": [
      "docs/**",
      "module/vendor/**",
      ".claude/**",
      ".foundry-dev/**",
      ".foundry-server/**"
    ]
  },
  "type": "module",
  "version": "0.70.45"
}
