{
  "enabledPlugins": {
    "foundryvtt-dev@cyface": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh run *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(mkdir *)",
      "Bash(npm run check)",
      "Bash(npm run compare-lang)",
      "Bash(npm run compare-lang *)",
      "Bash(npm run format)",
      "Bash(npm run format *)",
      "Bash(npm run scss)",
      "Bash(npm run scss *)",
      "Bash(npm run sync-core-lib)",
      "Bash(npm run test)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:unit)",
      "Bash(npm run todb)",
      "Bash(npm run tojson)",
      "Bash(npm test)",
      "Bash(python3 *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "WebFetch(domain:forums.forge-vtt.com)",
      "WebFetch(domain:foundryvtt.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git grep *)",
      "Bash(git ls-tree *)",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__list_console_messages",
      "Bash(npx playwright test *)",
      "Bash(npx vitest run *)",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__wait_for",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__claude-in-chrome__javascript_tool"
    ],
    "deny": []
  }
}
